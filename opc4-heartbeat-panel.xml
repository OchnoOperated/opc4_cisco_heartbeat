<!--
  OPTIONAL. Since monitor v2 the macro installs these panels itself
  (hidden source panel always, status panel when CONFIG.showStatusPanel = true).
  Import this file manually only if you prefer to manage the UI yourself.
-->
<Extensions>
  <Version>1.11</Version>
  <Panel>
    <Order>1</Order>
    <PanelId>opc4_heartbeat_panel</PanelId>
    <Origin>local</Origin>
    <Location>HomeScreen</Location>
    <Icon>Info</Icon>
    <Name>OPC4 Heartbeat</Name>
    <ActivityType>Custom</ActivityType>
    <Page>
      <Name>OPC4 Heartbeat</Name>
      <Row>
        <Name>State</Name>
        <Widget>
          <WidgetId>opc_state</WidgetId>
          <Name>opc_state</Name>
          <Type>Text</Type>
          <Options>size=4;fontSize=normal;align=left</Options>
        </Widget>
      </Row>
      <Row>
        <Name>Last Heartbeat</Name>
        <Widget>
          <WidgetId>opc_heartbeat</WidgetId>
          <Name>opc_heartbeat</Name>
          <Type>Text</Type>
          <Options>size=4;fontSize=normal;align=left</Options>
        </Widget>
      </Row>
      <Row>
        <Name>UC Mode</Name>
        <Widget>
          <WidgetId>opc_uc</WidgetId>
          <Name>opc_uc</Name>
          <Type>Text</Type>
          <Options>size=4;fontSize=normal;align=left</Options>
        </Widget>
      </Row>
      <Row>
        <Name>Connected Ports</Name>
        <Widget>
          <WidgetId>opc_connected</WidgetId>
          <Name>opc_connected</Name>
          <Type>Text</Type>
          <Options>size=4;fontSize=normal;align=left</Options>
        </Widget>
      </Row>
      <Row>
        <Name>Active Port</Name>
        <Widget>
          <WidgetId>opc_active</WidgetId>
          <Name>opc_active</Name>
          <Type>Text</Type>
          <Options>size=4;fontSize=normal;align=left</Options>
        </Widget>
      </Row>
      <Options/>
    </Page>
  </Panel>
  <Panel>
    <Order>2</Order>
    <PanelId>opc4_heartbeat_source_panel</PanelId>
    <Origin>local</Origin>
    <Location>Hidden</Location>
    <Icon>Info</Icon>
    <Name>OPC4 Heartbeat Source</Name>
    <ActivityType>Custom</ActivityType>
    <Page>
      <Name>OPC4 Heartbeat Source</Name>
      <Row>
        <Name>Status Source</Name>
        <Widget>
          <WidgetId>opc_status</WidgetId>
          <Name>opc_status</Name>
          <Type>Text</Type>
          <Options>size=4;fontSize=normal;align=left</Options>
        </Widget>
      </Row>
      <Options/>
    </Page>
  </Panel>
</Extensions>
